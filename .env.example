# Copy this file to .env and fill in real values. Never commit .env.

# --- Postgres (single datastore for app data, vectors, and Langfuse) ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=5432

# --- MinIO (S3-compatible object storage) ---
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=documents
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- LLM provider (Gemini free tier) ---
GEMINI_API_KEY=
LLM_PROVIDER=gemini
# Blank = default free-tier model. Non-free models need ALLOW_PAID_TIER=true.
GEMINI_MODEL=
ALLOW_PAID_TIER=false

# --- Langfuse (self-hosted, uses the Postgres instance above) ---
LANGFUSE_DB_NAME=
LANGFUSE_NEXTAUTH_URL=http://localhost:3001
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_PORT=3001

# --- Service ports / URLs ---
FASTAPI_PORT=8000
NEXTJS_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
